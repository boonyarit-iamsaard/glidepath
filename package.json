{
  "name": "glidepath",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "types:check": "turbo run types:check",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @glidepath/db",
    "db:studio": "turbo run db:studio -F @glidepath/db",
    "db:generate": "turbo run db:generate -F @glidepath/db",
    "db:migrate": "turbo run db:migrate -F @glidepath/db",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build --pull",
    "docker:up": "docker compose up -d --build --pull always",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "format": "prettier --write \"**/*.{md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{md,yaml,yml}\"",
    "lint:md": "markdownlint \"**/*.md\" --ignore-path .gitignore",
    "lint:md:fix": "markdownlint --fix \"**/*.md\" --ignore-path .gitignore",
    "ci": "biome ci --no-errors-on-unmatched --files-ignore-unknown=true . && pnpm format:check && pnpm lint:md && pnpm types:check && pnpm build",
    "audit": "pnpm audit --audit-level moderate && pnpm audit signatures",
    "deps:outdated": "pnpm outdated -r",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.12.0 <12"
  },
  "dependencies": {
    "@glidepath/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@glidepath/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ],
    "*.{md,yaml,yml}": [
      "prettier --check"
    ],
    "*.md": [
      "markdownlint --ignore-path .gitignore"
    ]
  },
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba"
}
