{
  "name": "glidepath",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "types:check": "turbo run types:check",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @glidepath/db",
    "db:studio": "turbo run db:studio -F @glidepath/db",
    "db:generate": "turbo run db:generate -F @glidepath/db",
    "db:migrate": "turbo run db:migrate -F @glidepath/db",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build --pull",
    "docker:up": "docker compose up -d --build --pull always",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "ci": "biome ci --no-errors-on-unmatched --files-ignore-unknown=true . && pnpm types:check && pnpm build",
    "audit": "pnpm audit --audit-level moderate && pnpm audit signatures",
    "deps:outdated": "pnpm outdated -r",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@glidepath/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@glidepath/config": "workspace:*",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "packageManager": "pnpm@11.12.0"
}
