{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "types:check": {
      "dependsOn": ["^types:check"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      // The route tree is a build output too. Without it here, a cache hit on a
      // clean checkout leaves tsc without the file, because Git ignores it.
      "outputs": ["dist/**", "src/routeTree.gen.ts"]
    },
    "web#types:check": {
      // `vite build` writes src/routeTree.gen.ts, so tsc needs the build first.
      // Turbo caches it, so `ci` builds web once.
      "dependsOn": ["^types:check", "build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:start": {
      "cache": false,
      "persistent": true
    },
    "db:stop": {
      "cache": false
    },
    "db:watch": {
      "cache": false,
      "persistent": true
    },
    "db:down": {
      "cache": false
    }
  }
}
