# Copy to apps/server/.env and replace the values.

# 32 characters or more. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-character-secret
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:password@localhost:5432/glidepath

# Optional. Defaults to 4000. Railway sets this for you.
# PORT=4000
